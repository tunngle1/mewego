# EAS build upload ignore list (repo root)
#
# Monorepo setup: upload ONLY the mobile app folder to EAS Build.
# Keep this strict so archive size stays far below 2 GB.

# Ignore everything by default
/*

# Include mobile app directory and all its contents
!/mobile
!/mobile/**

# Exclude local/generated files inside mobile
mobile/node_modules/
mobile/.gradle-home/
mobile/.gradle/
mobile/.idea/
mobile/android/
mobile/ios/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.log
mobile/.env
mobile/.env.*

