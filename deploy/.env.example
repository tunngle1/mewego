# Copy to .env on the server (next to docker-compose.yml) and fill in values.

POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://mewego:replace-me@postgres:5432/mewego
AUTH_JWT_SECRET=replace-with-strong-jwt-secret
AUTH_JWT_EXPIRES_IN=180d

# Required for password reset and email verification codes
EMAIL_FROM=noreply@yourdomain.ru
EMAIL_REPLY_TO=support@yourdomain.ru
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_SECURE=true
YANDEX_SMTP_USER=noreply@yourdomain.ru
YANDEX_SMTP_PASSWORD=replace-with-yandex-app-password

APP_WEB_URL=https://api.mewego.ru
APP_PUBLIC_URL=https://api.mewego.ru

ALLOW_DEV_HEADERS=false
ALLOW_DEV_ROLE_OVERRIDE=false
ENABLE_CRON_JOBS=true
