EXPO_PUBLIC_API_URL=http://192.168.0.121:3000/api/v1
YANDEX_MAPKIT_API_KEY=replace-with-yandex-mapkit-api-key

# 1 = логировать в консоль каждый HTTP-запрос (method + URL + status). Удобно с adb logcat для тестеров.
# Не включайте в продакшен-сборках для внешних пользователей.
EXPO_PUBLIC_DEBUG_NETWORK_LOG=0

# Event screen map markers (TestFlight isolation). 0 = Yamap only, 1 = Yamap + Marker when source is ready.
EXPO_PUBLIC_ENABLE_YANDEX_MAP_MARKERS=0
